ages/thumb/GreenEnergy.png/30px-GreenEnergy.png?38db59 1.5x, /images/thumb/GreenEnergy.png/40px-GreenEnergy.png?38db59 2x" data-file-width="164" data-file-height="164" /></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Crippling Cloud" data-rarity="Uncommon" data-type="Skill" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Exhaust Poison Weak"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Crippling_Cloud" title="Crippling Cloud"><img alt="Green-CripplingCloud.png" src="/images/thumb/Green-CripplingCloud.png/150px-Green-CripplingCloud.png?faad45" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-CripplingCloud.png/225px-Green-CripplingCloud.png?faad45 1.5x, /images/thumb/Green-CripplingCloud.png/300px-Green-CripplingCloud.png?faad45 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Crippling_Cloud" title="Crippling Cloud"><img alt="Green-CripplingCloudPlus.png" src="/images/thumb/Green-CripplingCloudPlus.png/150px-Green-CripplingCloudPlus.png?dceeb5" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-CripplingCloudPlus.png/225px-Green-CripplingCloudPlus.png?dceeb5 1.5x, /images/thumb/Green-CripplingCloudPlus.png/300px-Green-CripplingCloudPlus.png?dceeb5 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Crippling_Cloud" title="Crippling Cloud"><img alt="Beta-Green-CripplingCloudPlus.png" src="/images/thumb/Beta-Green-CripplingCloudPlus.png/150px-Beta-Green-CripplingCloudPlus.png?86280b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/B