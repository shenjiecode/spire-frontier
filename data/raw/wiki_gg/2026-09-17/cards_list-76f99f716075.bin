gSleeves.png/150px-Beta-Purple-FlyingSleeves.png?304812" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-FlyingSleeves.png/225px-Beta-Purple-FlyingSleeves.png?304812 1.5x, /images/thumb/Beta-Purple-FlyingSleeves.png/300px-Beta-Purple-FlyingSleeves.png?304812 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Flying_Sleeves" title="Flying Sleeves">Flying Sleeves</a></div><div class="card-meta" data-rarity="Common" data-color="Purple" data-type="Attack">Common - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base"><span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retain</a></span>. <br />Deal 4 damage twice.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retain</a></span>. <br />Deal 6 damage twice.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Follow-Up" data-rarity="Common" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Energy"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Follow-Up" title="Follow-Up"><img alt="Purple-Follow-Up.png" src="/images/thumb/Purple-Follow-Up.png/150px-Purple-Follow-Up.png?8ef563" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Follow-Up.png/225px-Purple-Follow-Up.png?8ef563 1.5x, /images/thumb/Purple-Follow-Up.png/300px-Purple-Follow-Up.png?8ef563 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Follow-Up" title="Follow-Up"><img alt="Purple-Follow-UpPlus.png" src="/images/thumb/Purple-Follow-UpPlus.png/150px-Purple-Follow-UpPlus.png?8fdf2d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Follow-UpPlus.png/225px-Purple-Follow-UpPlus.png?8fdf2d 1.5x, /images/thumb/Purple-Follow-UpPlus.png/300px-Purple-Follow-UpPlus.png?8fdf2d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Follow-Up" title="Follow-Up"><img alt="Beta-Purple-Follow-UpPlus.png" src="/images/thumb/Beta-Purple-Follow-UpPlus.png/150px-Beta-Purple-Follow-UpPlus.png?2b0e65" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Follow-UpPlus.png/225px-Beta-Purple-Follow-UpPlus.png?2b0e65 1.5x, /images/thumb/Beta-Purple-Follow-UpPlus.png/300px-Beta-Purple-Follow-UpPlus.png?2b0e65 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Follow-Up" title="Follow-Up"><img alt="Beta-Purple-Follow-Up.png" src="/images/thumb/Beta-Purple-Follow-Up.png/150px-Beta-Purple-Follow-Up.png?ee8c24" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Follow-Up.png/225px-Beta-Purple-Follow-Up.png?ee8c24 1.5x, /images/thumb/Beta-Purple-Follow-Up.png/300px-Beta-Purple-Follow-Up.png?ee8c24 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Follow-Up" title="Follow-Up">Follow-Up</a></div><div class="card-meta" data-rarity="Common" data-color="Purple" data-type="Attack">Common - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 7 damage. <br />If the previous card played was an Attack, gain <span class="keyword-trigger" data-name="@PE" data-sequel="1"><img alt="PurpleEnergy.png" src="/images/thumb/PurpleEnergy.png/20px-PurpleEnergy.png?bc09d7" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/PurpleEnergy.png/30px-PurpleEnergy.png?bc09d7 1.5x, /images/thumb/PurpleEnergy.png/40px-PurpleEnergy.png?bc09d7 2x" data-file-width="164" data-file-height="164" /></span>.</div><div class="desc-upg" style="display:none">Deal 11 damage. <br />If the previous card played was an Attack, gain <span class="keyword-trigger" data-name="@PE" data-sequel="1"><img alt="PurpleEnergy.png" src="/images/thumb/PurpleEnergy.png/20px-PurpleEnergy.png?bc09d7" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/PurpleEnergy.png/30px-PurpleEnergy.png?bc09d7 1.5x, /images/thumb/PurpleEnergy.png/40px-PurpleEnergy.png?bc09d7 2x" data-file-width="164" data-file-height="164" /></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Halt" data-rarity="Common" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags="Block Wrath"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Halt" title="Halt"><img alt="Purple-Halt.png" src="/images/thumb/Purple-Halt.png/150px-Purple-Halt.png?d5ffd0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Halt.png/225px-Purple-Halt.png?d5ffd0 1.5x, /images/thumb/Purple-Halt.png/300px-Purple-Halt.png?d5ffd0 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Halt" title="Halt"><img alt="Purple-HaltPlus.png" src="/images/thumb/Purple-HaltPlus.png/150px-Purple-HaltPlus.png?ff6c7c" decoding="async" loading="lazy" width="150" he