umb/Purple-TalktotheHandPlus.png/150px-Purple-TalktotheHandPlus.png?b60e29" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-TalktotheHandPlus.png/225px-Purple-TalktotheHandPlus.png?b60e29 1.5x, /images/thumb/Purple-TalktotheHandPlus.png/300px-Purple-TalktotheHandPlus.png?b60e29 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Talk_to_the_Hand" title="Talk to the Hand"><img alt="Beta-Purple-TalktotheHandPlus.png" src="/images/thumb/Beta-Purple-TalktotheHandPlus.png/150px-Beta-Purple-TalktotheHandPlus.png?8ff55d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-TalktotheHandPlus.png/225px-Beta-Purple-TalktotheHandPlus.png?8ff55d 1.5x, /images/thumb/Beta-Purple-TalktotheHandPlus.png/300px-Beta-Purple-TalktotheHandPlus.png?8ff55d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Talk_to_the_Hand" title="Talk to the Hand"><img alt="Beta-Purple-TalktotheHand.png" src="/images/thumb/Beta-Purple-TalktotheHand.png/150px-Beta-Purple-TalktotheHand.png?d15659" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-TalktotheHand.png/225px-Beta-Purple-TalktotheHand.png?d15659 1.5x, /images/thumb/Beta-Purple-TalktotheHand.png/300px-Beta-Purple-TalktotheHand.png?d15659 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Talk_to_the_Hand" title="Talk to the Hand">Talk to the Hand</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 5 damage. Whenever you attack this enemy, gain 2 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>. <br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1" title=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div><div class="desc-upg" style="display:none">Deal 7 damage. Whenever you attack this enemy, gain 3 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>. <br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1" title=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Tantrum" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Wrath"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Tantrum" title="Tantrum"><img alt="Purple-Tantrum.png" src="/images/thumb/Purple-Tantrum.png/150px-Purple-Tantrum.png?678105" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Tantrum.png/225px-Purple-Tantrum.png?678105 1.5x, /images/thumb/Purple-Tantrum.png/300px-Purple-Tantrum.png?678105 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Tantrum" title="Tantrum"><img alt="Purple-TantrumPlus.png" src="/images/thumb/Purple-TantrumPlus.png/150px-Purple-TantrumPlus.png?fd8eb4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-TantrumPlus.png/225px-Purple-TantrumPlus.png?fd8eb4 1.5x, /images/thumb/Purple-TantrumPlus.png/300px-Purple-TantrumPlus.png?fd8eb4 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Tantrum" title="Tantrum"><img alt="Beta-Purple-TantrumPlus.png" src="/images/thumb/Beta-Purple-TantrumPlus.png/150px-Beta-Purple-TantrumPlus.png?7309c4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-TantrumPlus.png/225px-Beta-Purple-TantrumPlus.png?7309c4 1.5x, /images/thumb/Beta-Purple-TantrumPlus.png/300px-Beta-Purple-TantrumPlus.png?7309c4 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Tantrum" title="Tantrum"><img alt="Beta-Purple-Tantrum.png" src="/images/thumb/Beta-Purple-Tantrum.png/150px-Beta-Purple-Tantrum.png?a88f4b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Tantrum.png/225px-Beta-Purple-Tantrum.png?a88f4b 1.5x, /images/thumb/Beta-Purple-Tantrum.png/300px-Beta-Purple-Tantrum.png?a88f4b 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Tantrum" title="Tantrum">Tantrum</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 3 damage 3 times.<br />Enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span>.<br />Shuffle this card into your draw pile.</div><div class="desc-upg" style="display:none">Deal 3 damage 4 times.<br />Enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span>.<br />Shuffle this card into your draw pile.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Wallop" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Wallop" title="Wallop"><img alt="Purple-Wallop.png" src="/images/thumb/Purple-Wallop.png/150px-Purple-Wallop.png?66677c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Wallop.png/225px-Purple-Wallop.png?66677c 1.5x, /images/thumb/Purple-Wallop.png/300px-Purple-Wallop.png?66677c 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Wallop" title="Wallop"><img alt="Purple-WallopPlus.png" src="/images/thumb/Purple-WallopPlus.png/150px-Purple-WallopPlus.png?463c6a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-WallopPlus.png/225px-Purple-WallopPlus.png?463c6a 1.5x, /images/thumb/Purple-WallopPlus.png/300px-Purple-WallopPlus.png?463c6a 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Wallop" title="Wallop"><img alt="Beta-Purple-WallopPlus.png" src="/images/thumb/Beta-Purple-WallopPlus.png/150px-Beta-Purple-WallopPlus.png?ed54fb" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-WallopPlus.png/225px-Beta-Purple-WallopPlus.png?ed54fb 1.5x, /images/thumb/Beta-Purple-WallopPlus.png/300px-Beta-Purple-WallopPlus.png?ed54fb 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Wallop" title="Wallop"><img alt="Beta-Purple-Wallop.png" src="/images/thumb/Beta-Purple-Wallop.png/150px-Beta-Purple-Wallop.png?acd8f4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Wallop.png/225px-Beta-Purple-Wallop.png?acd8f4 1.5x, /images/thumb/Beta-Purple-Wallop.png/300px-Beta-Purple-Wallop.png?acd8f4 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Wallop" title="Wallop">Wallop</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 9 damage.<br />Gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span> equal to unblocked damage dealt.</div><div class="desc-upg" style="display:none">Deal 12 damage.<br />Gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span> equal to unblocked damage dealt.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Wave of the Hand" data-rarity="Uncommon" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Block Weak"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Wave_of_the_Hand" title="Wave of the Hand"><img alt="Purple-WaveoftheHand.png" src="/images/thumb/Purple-WaveoftheHand.png/150px-Purple-WaveoftheHand.png?105131" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-WaveoftheHand.png/225px-Purple-WaveoftheHand.png?105131 1.5x, /images/thumb/Purple-WaveoftheHand.png/300px-Purple-WaveoftheHand.png?105131 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Wave_of_the_Hand" title="Wave of the Hand"><img alt="Purple-WaveoftheHandPlus.png" src="/images/thumb/Purple-WaveoftheHandPlus.png/150px-Purple-WaveoftheHandPlus.png?bf6883" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-WaveoftheHandPlus.png/225px-Purple-WaveoftheHandPlus.png?bf6883 1.5x, /images/thumb/Purple-WaveoftheHandPlus.png/300px-Purple-WaveoftheHandPlus.png?bf6883 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Wave_of_the_Hand" title="Wave of the Hand"><img alt="Beta-Purple-WaveoftheHandPlus.png" src="/images/thumb/Beta-Purple-WaveoftheHandPlus.png/150px-Beta-Purple-WaveoftheHandPlus.png?9a4a3c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-WaveoftheHandPlus.png/225px-Beta-Purple-WaveoftheHandPlus.png?9a4a3c 1.5x, /images/thumb/Beta-Purple-WaveoftheHandPlus.png/300px-Beta-Purple-WaveoftheHandPlus.png?9a4a3c 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Wave_of_the_Hand" title="Wave of the Hand"><img alt="Beta-Purple-WaveoftheHand.png" src="/images/thumb/Beta-Purple-WaveoftheHand.png/150px-Beta-Purple-WaveoftheHand.png?adc366" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-WaveoftheHand.png/225px-Beta-Purple-WaveoftheHand.png?adc366 1.5x, /images/thumb/Beta-Purple-WaveoftheHand.png/300px-Beta-Purple-WaveoftheHand.png?adc366 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Wave_of_the_Hand" title="Wave of the Hand">Wave of the Hand</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Skill">Uncommon - Watcher - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Whenever you gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span> this turn, apply 1 <span class="power-trigger inline-trigger" data-name="Weak" data-sequel="1"><a href="/wiki/Weak" title="Weak"><img alt="Icon Weak.png" src="/images/thumb/Icon_Weak.png/22px-Icon_Weak.png?261352" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Weak.png/33px-Icon_Weak.png?261352 1.5x, /images/thumb/Icon_Weak.png/44px-Icon_Weak.png?261352 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Weak" title="Weak">Weak</a></span> to ALL enemies.</div><div class="desc-upg" style="display:none">Whenever you gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span> this turn, apply 2 <span class="power-trigger inline-trigger" data-name="Weak" data-sequel="1"><a href="/wiki/Weak" title="Weak"><img alt="Icon Weak.png" src="/images/thumb/Icon_Weak.png/22px-Icon_Weak.png?261352" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Weak.png/33px-Icon_Weak.png?261352 1.5x, /images/thumb/Icon_Weak.png/44px-Icon_Weak.png?261352 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Weak" title="Weak">Weak</a></span> to ALL enemies.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Weave" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags="Hand Scry"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Weave" title="Weave"><img alt="Purple-Weave.p