er-trigger inline-trigger" data-name="Poison" data-sequel="1"><a href="/wiki/Poison" title="Poison"><img alt="Icon Poison.png" src="/images/thumb/Icon_Poison.png/22px-Icon_Poison.png?628f4a" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Poison.png/33px-Icon_Poison.png?628f4a 1.5x, /images/thumb/Icon_Poison.png/44px-Icon_Poison.png?628f4a 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Poison" title="Poison">Poison</a></span> to a random enemy 4 times.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Calculated Gamble" data-rarity="Uncommon" data-type="Skill" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags="Discard Draw Exhaust"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Calculated_Gamble" title="Calculated Gamble"><img alt="Green-CalculatedGamble.png" src="/images/thumb/Green-CalculatedGamble.png/150px-Green-CalculatedGamble.png?34b4f8" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-CalculatedGamble.png/225px-Green-CalculatedGamble.png?34b4f8 1.5x, /images/thumb/Green-CalculatedGamble.png/300px-Green-CalculatedGamble.png?34b4f8 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Calculated_Gamble" title="Calculated Gamble"><img alt="Green-CalculatedGamblePlus.png" src="/images/thumb/Green-CalculatedGamblePlus.png/150px-Green-CalculatedGamblePlus.png?fb9404" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-CalculatedGamblePlus.png/225px-Green-CalculatedGamblePlus.png?fb9404 1.5x, /images/thumb/Green-CalculatedGamblePlus.png/300px-Green-CalculatedGamblePlus.png?fb9404 2x" data-file-wid