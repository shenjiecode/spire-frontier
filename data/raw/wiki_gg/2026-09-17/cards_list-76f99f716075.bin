-BlueEnergy.png?9ac3e7 2x" data-file-width="164" data-file-height="164" /></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Claw" data-rarity="Common" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Claw" title="Claw"><img alt="Blue-Claw.png" src="/images/thumb/Blue-Claw.png/150px-Blue-Claw.png?1c3a11" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Claw.png/225px-Blue-Claw.png?1c3a11 1.5x, /images/thumb/Blue-Claw.png/300px-Blue-Claw.png?1c3a11 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Claw" title="Claw"><img alt="Blue-ClawPlus.png" src="/images/thumb/Blue-ClawPlus.png/150px-Blue-ClawPlus.png?5fe4a1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-ClawPlus.png/225px-Blue-ClawPlus.png?5fe4a1 1.5x, /images/thumb/Blue-ClawPlus.png/300px-Blue-ClawPlus.png?5fe4a1 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Claw" title="Claw"><img alt="Beta-Blue-ClawPlus.png" src="/images/thumb/Beta-Blue-ClawPlus.png/150px-Beta-Blue-ClawPlus.png?9d1dc7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-ClawPlus.png/225px-Beta-Blue-ClawPlus.png?9d1dc7 1.5x, /images/thumb/Beta-Blue-ClawPlus.png/300px-Beta-Blue-ClawPlus.png?9d1dc7 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Claw" title="Claw"><img alt="Beta-Blue-Claw.png" src="/images/thumb/Beta-Blue-Claw.png/150px-Beta-Blue-Claw.png?c5bacd" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-Claw.png/225px-Beta-Blue-Claw.png?c5bacd 1.5x, /images/thumb/Beta-Blue-Claw.png/300px-Beta-Blue-Claw.png?c5bacd 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Claw" title="Claw">Claw</a></div><div class="card-meta" data-rarity="Common" data-color="Blue" data-type="Attack">Common - Defect - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 3 damage.<br />Increase the damage of ALL Claw cards by 2 this combat.</div><div class="desc-upg" style="display:none">Deal 5 damage.<br />Increase the damage of ALL Claw cards by 2 this combat.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Cold Snap" data-rarity="Common" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Channel Frost"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Cold_Snap" title="Cold Snap"><img alt="Blue-ColdSnap.png" src="/images/thumb/Blue-ColdSnap.png/150px-Blue-ColdSnap.png?d1ead7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-ColdSnap.png/225px-Blue-ColdSnap.png?d1ead7 1.5x, /images/thumb/Blue-ColdSnap.png/300px-Blue-ColdSnap.png?d1ead7 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Cold_Snap" title="Cold Snap"><img alt="Blue-ColdSnapPlus.png" src="/images/thumb/Blue-ColdSnapPlus.png/150px-Blue-ColdSnapPlus.png?850fa6" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-ColdSnapPlus.png/225px-Blue-ColdSnapPlus.png?850fa6 1.5x, /images/thumb/Blue-ColdSnapPlus.png/300px-Blue-ColdSnapPlus.png?850fa6 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Cold_Snap" title="Cold Snap"><img alt="Beta-Blue-ColdSnapPlus.png" src="/images/thumb/Beta-Blue-ColdSnapPlus.png/150px-Beta-Blue-ColdSnapPlus.png?4d7b04" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-ColdSnapPlus.png/225px-Beta-Blue-ColdSnapPlus.png?4d7b04 1.5x, /images/thumb/Beta-Blue-ColdSnapPlus.png/300px-Beta-Blue-ColdSnapPlus.png?4d7b04 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Cold_Snap" title="Cold Snap"><img alt="Beta-Blue-ColdSnap.png" src="/images/thumb/Beta-Blue-ColdSnap.png/150px-Beta-Blue-ColdSnap.png?48b884" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-ColdSnap.png/225px-Beta-Blue-ColdSnap.png?48b884 1.5x, /images/thumb/Beta-Blue-ColdSnap.png/300px-Beta-Blue-ColdSnap.png?48b884 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Cold_Snap" title="Cold Snap">Cold Snap</a></div><div class="card-meta" data-rarity="Common" data-color="Blue" data-type="Attack">Common - Defect - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 6 damage. <span class="keyword-trigger inline-trigger" data-name="Channel" data-sequel="1"><a href="/wiki/Orbs" title="Orbs"><span title="">Channel</span></a></span> 1 <span class="keyword-trigger inline-trigger" data-name="Frost" data-sequel="1"><a href="/wiki/Frost" title="Frost"><img alt="FrostOrb.png" src="/images/thumb/FrostOrb.png/18px-FrostOrb.png?213701" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/FrostOrb.png/27px-FrostOrb.png?213701 1.5x, /images/thumb/FrostOrb.png/36px-FrostOrb.png?213701 2x" data-file-width="71" data-file-height="71" /></a> <a href="/wiki/Frost" title="Frost"><span title="">Frost</span></a></span>.</div><div class="desc-upg" style="display:none">Deal 9 damage. <span class="keyword-trigger inline-trigger" data-name="Channel" data-sequel="1"><a href="/wiki/Orbs" title="Orbs"><span title="">Channel</span></a></span> 1 <span class="keyword-trigger inline-trigger" data-name="Frost" data-sequel="1"><a href="/wiki/Frost" title="Frost"><img alt="FrostOrb.png" src="/images/thumb/FrostOrb.png/18px-FrostOrb.png?213701" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/FrostOrb.png/27px-FrostOrb.png?213701 1.5x, /images/thumb/FrostOrb.png/36px-FrostOrb.png?213701 2x" data-file-width="71" data-file-height="71" /></a> <a href="/wiki/Frost" title="Frost"><span title="">Frost</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Compile Driver" data-rarity="Common" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Draw"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Compile_Driver" title="Compile Driver"><img alt="Blue-CompileDriver.png" src="/images/thumb/Blue-CompileDriver.png/150px-Blue-CompileDriver.png?1ff983" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-CompileDriver.png/225px-Blue-CompileDriver.png?1ff983 1.5x, /images/thumb/Blue-CompileDriver.png/300px-Blue-CompileDriver.png?1ff983 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Compile_Driver" title="Compile Driver"><img alt="Blue-CompileDriverPlus.png" src="/images/thumb/Blue-CompileDriverPlus.png/150px-Blue-CompileDriverPlus.png?921a60" decoding="async" loading="lazy" wi