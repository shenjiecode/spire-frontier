ard-text"><div class="card-title compendium-cell-title"><a href="/wiki/Hello_World" title="Hello World">Hello World</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Blue" data-type="Power">Uncommon - Defect - Power</div><div class="card-desc compendium-cell-desc"><div class="desc-base">At the start of your turn, add a random Common card into your hand.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Innate" data-sequel="1" title=""><a href="/wiki/Keywords#Innate" title="Keywords">Innate</a></span>. <br />At the start of your turn, add a random Common card into your hand.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Loop" data-rarity="Uncommon" data-type="Power" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Loop" title="Loop"><img alt="Blue-Loop.png" src="/images/thumb/Blue-Loop.png/150px-Blue-Loop.png?124f32" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Loop.png/225px-Blue-Loop.png?124f32 1.5x, /images/thumb/Blue-Loop.png/300px-Blue-Loop.png?124f32 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Loop" title="Loop"><img alt="Blue-LoopPlus.png" src="/images/thumb/Blue-LoopPlus.png/150px-Blue-LoopPlus.png?779c2b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-LoopPlus.png/225px-Blue-LoopPlus.png?779c2b 1.5x, /images/thumb/Blue-LoopPlus.png/300px-Blue-LoopPlus.png?779c2b 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Loop" title="Loop"><img alt="Beta-Blue-LoopPlus.png" src="/images/thumb/Beta-Blue-LoopPlus.png/150px-Beta-Blue-LoopPlus.png?c902ee" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-LoopPlus.png/225px-Beta-Blue-LoopPlus.png?c902ee 1.5x, /images/thumb/Beta-Blue-LoopPlus.png/300px-Beta-Blue-LoopPlus.png?c902ee 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Loop" title="Loop"><img alt="Beta-Blue-Loop.png" src="/images/thumb/Beta-Blue-Loop.png/150px-Beta-Blue-Loop.png?aa0ed1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-Loop.png/225px-Beta-Blue-Loop.png?aa0ed1 1.5x, /images/thumb/Beta-Blue-Loop.png/300px-Beta-Blue-Loop.png?aa0ed1 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Loop" title="Loop">Loop</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Blue" data-type="Power">Uncommon - Defect - Power</div><div class="card-desc compendium-cell-desc"><div class="desc-base">At the start of your turn, trigger the passive ability of your next Orb 1 time.</div><div class="desc-upg" style="display:none">At the start of your turn, trigger the passive ability of your next Orb 2 times.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Melter" data-rarity="Uncommon" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Melter" title="Melter"><img alt="Blue-Melter.png" src="/images/thumb/Blue-Melter.png/150px-Blue-Melter.png?9130df" decoding="async" loading="lazy" width="150" height="19