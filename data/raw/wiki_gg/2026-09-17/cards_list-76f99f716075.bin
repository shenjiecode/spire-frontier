mb/LightningOrb.png/18px-LightningOrb.png?295517" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/LightningOrb.png/27px-LightningOrb.png?295517 1.5x, /images/thumb/LightningOrb.png/36px-LightningOrb.png?295517 2x" data-file-width="70" data-file-height="70" /></a> <a href="/wiki/Lightning" title="Lightning"><span title="">Lightning</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Barrage" data-rarity="Common" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Channel"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Barrage" title="Barrage"><img alt="Blue-Barrage.png" src="/images/thumb/Blue-Barrage.png/150px-Blue-Barrage.png?cd9882" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Barrage.png/225px-Blue-Barrage.png?cd9882 1.5x, /images/thumb/Blue-Barrage.png/300px-Blue-Barrage.png?cd9882 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Barrage" title="Barrage"><img alt="Blue-BarragePlus.png" src="/images/thumb/Blue-BarragePlus.png/150px-Blue-BarragePlus.png?3fdbe0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-BarragePlus.png/225px-Blue-BarragePlus.png?3fdbe0 1.5x, /images/thumb/Blue-BarragePlus.png/300px-Blue-BarragePlus.png?3fdbe0 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Barrage" title="Barrage"><img alt="Beta-Blue-BarragePlus.png" src="/images/thumb/Beta-Blue-BarragePlus.png/150px-Beta-Blue-BarragePlus.png?e90eb7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-