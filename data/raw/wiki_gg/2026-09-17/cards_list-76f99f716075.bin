2x" data-file-width="164" data-file-height="164" /></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1" title=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Envenom" data-rarity="Rare" data-type="Power" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Poison"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Envenom" title="Envenom"><img alt="Green-Envenom.png" src="/images/thumb/Green-Envenom.png/150px-Green-Envenom.png?244105" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-Envenom.png/225px-Green-Envenom.png?244105 1.5x, /images/thumb/Green-Envenom.png/300px-Green-Envenom.png?244105 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Envenom" title="Envenom"><img alt="Green-EnvenomPlus.png" src="/images/thumb/Green-EnvenomPlus.png/150px-Green-EnvenomPlus.png?bf350d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-EnvenomPlus.png/225px-Green-EnvenomPlus.png?bf350d 1.5x, /images/thumb/Green-EnvenomPlus.png/300px-Green-EnvenomPlus.png?bf350d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Envenom" title="Envenom"><img alt="Beta-Green-EnvenomPlus.png" src="/images/thumb/Beta-Green-EnvenomPlus.png/150px-Beta-Green-EnvenomPlus.png?a8d2ec" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Green-EnvenomPlus.png/225px-Beta-Green-EnvenomPlus.png?a8d2ec 1.5x, /images/thumb/Beta-Green-EnvenomPlus.png/300px-Beta-Green-EnvenomPlus.png?