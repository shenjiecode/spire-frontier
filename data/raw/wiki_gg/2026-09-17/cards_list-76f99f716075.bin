antra.png/44px-Icon_Mantra.png?5ed5ac 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Buffs#Mantra" title="Buffs">Mantra</a></span>.<br />Shuffle an <span class="card-trigger inline-trigger" data-name="Insight" data-sequel="1"><a href="/wiki/Insight" title="Insight"><img alt="CardIcon Colorless Skill Common.png" src="/images/thumb/CardIcon_Colorless_Skill_Common.png/24px-CardIcon_Colorless_Skill_Common.png?9ab8b5" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Skill_Common.png?9ab8b5 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Insight" title="Insight">Insight</a></span> into your draw pile.</div><div class="desc-upg" style="display:none">Gain 4 <span class="power-trigger inline-trigger" data-name="Mantra" data-sequel="1"><a href="/wiki/Buffs#Mantra" title="Buffs"><img alt="Icon Mantra.png" src="/images/thumb/Icon_Mantra.png/22px-Icon_Mantra.png?5ed5ac" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Mantra.png/33px-Icon_Mantra.png?5ed5ac 1.5x, /images/thumb/Icon_Mantra.png/44px-Icon_Mantra.png?5ed5ac 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Buffs#Mantra" title="Buffs">Mantra</a></span>.<br />Shuffle an <span class="card-trigger inline-trigger" data-name="Insight" data-sequel="1"><a href="/wiki/Insight" title="Insight"><img alt="CardIcon Colorless Skill Common.png" src="/images/thumb/CardIcon_Colorless_Skill_Common.png/24px-CardIcon_Colorless_Skill_Common.png?9ab8b5" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Skill_Common.png?9ab8b5 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Insight" title="Insight">Insight</a></span> into your draw pile.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Reach Heaven" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Reach_Heaven" title="Reach Heaven"><img alt="Purple-ReachHeaven.png" src="/images/thumb/Purple-ReachHeaven.png/150px-Purple-ReachHeaven.png?4ceb64" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-ReachHeaven.png/225px-Purple-ReachHeaven.png?4ceb64 1.5x, /images/thumb/Purple-ReachHeaven.png/300px-Purple-ReachHeaven.png?4ceb64 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Reach_Heaven" title="Reach Heaven"><img alt="Purple-ReachHeavenPlus.png" src="/images/thumb/Purple-ReachHeavenPlus.png/150px-Purple-ReachHeavenPlus.png?4ecf5f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-ReachHeavenPlus.png/225px-Purple-ReachHeavenPlus.png?4ecf5f 1.5x, /images/thumb/Purple-ReachHeavenPlus.png/300px-Purple-ReachHeavenPlus.png?4ecf5f 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Reach_Heaven" title="Reach Heaven"><img alt="Beta-Purple-ReachHeavenPlus.png" src="/images/thumb/Beta-Purple-ReachHeavenPlus.png/150px-Beta-Purple-ReachHeavenPlus.png?965d28" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-ReachHeavenPlus.png/225px-Beta-Purple-ReachHeavenPlus.png?965d28 1.5x, /images/thumb/Beta-Purple-ReachHeavenPlus.png/300px-Beta-Purple-ReachHeavenPlus.png?965d28 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Reach_Heaven" title="Reach Heaven"><img alt="Beta-Purple-ReachHeaven.png" src="/images/thumb/Beta-Purple-ReachHeaven.png/150px-Beta-Purple-ReachHeaven.png?efb6ab" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-ReachHeaven.png/225px-Beta-Purple-ReachHeaven.png?efb6ab 1.5x, /images/thumb/Beta-Purple-ReachHeaven.png/300px-Beta-Purple-ReachHeaven.png?efb6ab 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Reach_Heaven" title="Reach Heaven">Reach Heaven</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 10 damage. Shuffle a <span class="card-trigger inline-trigger" data-name="Through Violence" data-sequel="1"><a href="/wiki/Through_Violence" title="Through Violence"><img alt="CardIcon Colorless Attack Common.png" src="/images/thumb/CardIcon_Colorless_Attack_Common.png/24px-CardIcon_Colorless_Attack_Common.png?4d1ee4" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Attack_Common.png?4d1ee4 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Through_Violence" class="mw-redirect" title="Through Violence">Through Violence</a></span> into your draw pile.</div><div class="desc-upg" style="display:none">Deal 15 damage. Shuffle a <span class="card-trigger inline-trigger" data-name="Through Violence" data-sequel="1"><a href="/wiki/Through_Violence" title="Through Violence"><img alt="CardIcon Colorless Attack Common.png" src="/images/thumb/CardIcon_Colorless_Attack_Common.png/24px-CardIcon_Colorless_Attack_Common.png?4d1ee4" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Attack_Common.png?4d1ee4 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Through_Violence" class="mw-redirect" title="Through Violence">Through Violence</a></span> into your draw pile.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Rushdown" data-rarity="Uncommon" data-type="Power" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Draw Wrath"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Rushdown" title="Rushdown"><img alt="Purple-Rushdown.png" src="/images/thumb/Purple-Rushdown.png/150px-Purple-Rushdown.png?b28ec7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Rushdown.png/225px-Purple-Rushdown.png?b28ec7 1.5x, /images/thumb/Purple-Rushdown.png/300px-Purple-Rushdown.png?b28ec7 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Rushdown" title="Rushdown"><img alt="Purple-RushdownPlus.png" src="/images/thumb/Purple-RushdownPlus.png/150px-Purple-RushdownPlus.png?5f9ab3" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-RushdownPlus.png/225px-Purple-RushdownPlus.png?5f9ab3 1.5x, /images/thumb/Purple-RushdownPlus.png/300px-Purple-RushdownPlus.png?5f9ab3 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Rushdown" title="Rushdown"><img alt="Beta-Purple-RushdownPlus.png" src="/images/thumb/Beta-Purple-RushdownPlus.png/150px-Beta-Purple-RushdownPlus.png?4f6a03" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-RushdownPlus.png/225px-Beta-Purple-RushdownPlus.png?4f6a03 1.5x, /images/thumb/Beta-Purple-RushdownPlus.png/300px-Beta-Purple-RushdownPlus.png?4f6a03 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Rushdown" title="Rushdown"><img alt="Beta-Purple-Rushdown.png" src="/images/thumb/Beta-Purple-Rushdown.png/150px-Beta-Purple-Rushdown.png?2f1266" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Rushdown.png/225px-Beta-Purple-Rushdown.png?2f1266 1.5x, /images/thumb/Beta-Purple-Rushdown.png/300px-Beta-Purple-Rushdown.png?2f1266 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Rushdown" title="Rushdown">Rushdown</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Power">Uncommon - Watcher - Power</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Whenever you enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span>, draw 2 cards.</div><div class="desc-upg" style="display:none">Whenever you enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span>, draw 2 cards.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Sanctity" data-rarity="Uncommon" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Block Draw"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Sanctity" title="Sanctity"><img alt="Purple-Sanctity.png" src="/images/thumb/Purple-Sanctity.png/150px-Purple-Sanctity.png?3bfcb1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Sanctity.png/225px-Purple-Sanctity.png?3bfcb1 1.5x, /images/thumb/Purple-Sanctity.png/300px-Purple-Sanctity.png?3bfcb1 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Sanctity" title="Sanctity"><img alt="Purple-SanctityPlus.png" src="/images/thumb/Purple-SanctityPlus.png/150px-Purple-SanctityPlus.png?1e633c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SanctityPlus.png/225px-Purple-SanctityPlus.png?1e633c 1.5x, /images/thumb/Purple-SanctityPlus.png/300px-Purple-SanctityPlus.png?1e633c 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Sanctity" title="Sanctity"><img alt="Beta-Purple-SanctityPlus.png" src="/images/thumb/Beta-Purple-SanctityPlus.png/150px-Beta-Purple-SanctityPlus.png?7508a1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SanctityPlus.png/225px-Beta-Purple-SanctityPlus.png?7508a1 1.5x, /images/thumb/Beta-Purple-SanctityPlus.png/300px-Beta-Purple-SanctityPlus.png?7508a1 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Sanctity" title="Sanctity"><img alt="Beta-Purple-Sanctity.png" src="/images/thumb/Beta-Purple-Sanctity.png/150px-Beta-Purple-Sanctity.png?b26ec0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Sanctity.png/225px-Beta-Purple-Sanctity.png?b26ec0 1.5x, /images/thumb/Beta-Purple-Sanctity.png/300px-Beta-Purple-Sanctity.png?b26ec0 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Sanctity" title="Sanctity">Sanctity</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Skill">Uncommon - Watcher - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Gain 6 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block">Block</a></span>. <br />If the last card played this combat was a Skill, draw 2 cards.</div><div class="desc-upg" style="display:none">Gain 9 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block">Block</a></span>. <br />If the last card played this combat was a Skill, draw 2 cards.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Sands of Time" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="4" data-multiplayer="false" data-tags="Retain"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Sands_of_Time" title="Sands of Time"><img alt="Purple-SandsofTime.png" src="/images/thumb/Purple-SandsofTime.png/150px-Purple-SandsofTime.png?b1544e" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SandsofTime.png/225px-Purple-SandsofTime.png?b1544e 1.5x, /images/thumb/Purple-SandsofTime.png/300px-Purple-SandsofTime.png?b1544e 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Sands_of_Time" title="Sands of Time"><img alt="Purple-SandsofTimePlus.png" src="/images/thumb/Purple-SandsofTimePlus.png/150px-Purple-SandsofTimePlus.png?95ce1d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SandsofTimePlus.png/225px-Purple-SandsofTimePlus.png?95ce1d 1.5x, /images/thumb/Purple-SandsofTimePlus.png/300px-Purple-SandsofTimePlus.png?95ce1d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Sands_of_Time" title="Sands of Time"><img alt="Beta-Purple-SandsofTimePlus.png" src="/images/thumb/Beta-Purple-SandsofTimePlus.png/150px-Beta-Purple-SandsofTimePlus.png?504513" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SandsofTimePlus.png/225px-Beta-Purple-SandsofTimePlus.png?504513 1.5x, /images/thumb/Beta-Purple-SandsofTimePlus.png/300px-Beta-Purple-SandsofTimePlus.png?504513 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Sands_of_Time" title="Sands of Time"><img alt="Beta-Purple-SandsofTime.png" src="/images/thumb/Beta-Purple-SandsofTime.png/150px-Beta-Purple-SandsofTime.png?ff845a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SandsofTime.png/225px-Beta-Purple-SandsofTime.png?ff845a 1.5x, /images/thumb/Beta-Purple-SandsofTime.png/300px-Beta-Purple-SandsofTime.png?ff845a 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Sands_of_Time" title="Sands of Time">Sands of Time</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base"><span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retain</a></span>.<br />Deal 20 damage.<br />When <span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retained</a></span>, lower its cost by 1 this combat.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retain</a></span>.<br />Deal 26 damage.<br />When <span class="keyword-trigger inline-trigger" data-name="Retain" data-sequel="1" title=""><a href="/wiki/Keywords#Retain" title="Keywords">Retained</a></span>, lower its cost by 1 this combat.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Signature Move" data-rarity="Uncommon" data-type="Attack" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Hand"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Signature_Move" title="Signature Move"><img alt="Purple-SignatureMove.png" src="/images/thumb/Purple-SignatureMove.png/150px-Purple-SignatureMove.png?717326" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SignatureMove.png/225px-Purple-SignatureMove.png?717326 1.5x, /images/thumb/Purple-SignatureMove.png/300px-Purple-SignatureMove.png?717326 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Signature_Move" title="Signature Move"><img alt="Purple-SignatureMovePlus.png" src="/images/thumb/Purple-SignatureMovePlus.png/150px-Purple-SignatureMovePlus.png?aac72c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SignatureMovePlus.png/225px-Purple-SignatureMovePlus.png?aac72c 1.5x, /images/thumb/Purple-SignatureMovePlus.png/300px-Purple-SignatureMovePlus.png?aac72c 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Signature_Move" title="Signature Move"><img alt="Beta-Purple-SignatureMovePlus.png" src="/images/thumb/Beta-Purple-SignatureMovePlus.png/150px-Beta-Purple-SignatureMovePlus.png?8757fc" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SignatureMovePlus.png/225px-Beta-Purple-SignatureMovePlus.png?8757fc 1.5x, /images/thumb/Beta-Purple-SignatureMovePlus.png/300px-Beta-Purple-SignatureMovePlus.png?8757fc 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Signature_Move" title="Signature Move"><img alt="Beta-Purple-SignatureMove.png" src="/images/thumb/Beta-Purple-SignatureMove.png/150px-Beta-Purple-SignatureMove.png?1789a4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SignatureMove.png/225px-Beta-Purple-SignatureMove.png?1789a4 1.5x, /images/thumb/Beta-Purple-SignatureMove.png/300px-Beta-Purple-SignatureMove.png?1789a4 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Signature_Move" title="Signature Move">Signature Move</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Attack">Uncommon - Watcher - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Can only be played if this is the only Attack in your hand. <br />Deal 30 damage.</div><div class="desc-upg" style="display:none">Can only be played if this is the only Attack in your hand. <br />Deal 40 damage.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Simmering Fury" data-rarity="Uncommon" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Draw Wrath"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Simmering_Fury" title="Simmering Fury"><img alt="Purple-SimmeringFury.png" src="/images/thumb/Purple-SimmeringFury.png/150px-Purple-SimmeringFury.png?5b986f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SimmeringFury.png/225px-Purple-SimmeringFury.png?5b986f 1.5x, /images/thumb/Purple-SimmeringFury.png/300px-Purple-SimmeringFury.png?5b986f 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Simmering_Fury" title="Simmering Fury"><img alt="Purple-SimmeringFuryPlus.png" src="/images/thumb/Purple-SimmeringFuryPlus.png/150px-Purple-SimmeringFuryPlus.png?5c9342" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-SimmeringFuryPlus.png/225px-Purple-SimmeringFuryPlus.png?5c9342 1.5x, /images/thumb/Purple-SimmeringFuryPlus.png/300px-Purple-SimmeringFuryPlus.png?5c9342 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Simmering_Fury" title="Simmering Fury"><img alt="Beta-Purple-SimmeringFuryPlus.png" src="/images/thumb/Beta-Purple-SimmeringFuryPlus.png/150px-Beta-Purple-SimmeringFuryPlus.png?9f82f2" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SimmeringFuryPlus.png/225px-Beta-Purple-SimmeringFuryPlus.png?9f82f2 1.5x, /images/thumb/Beta-Purple-SimmeringFuryPlus.png/300px-Beta-Purple-SimmeringFuryPlus.png?9f82f2 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Simmering_Fury" title="Simmering Fury"><img alt="Beta-Purple-SimmeringFury.png" src="/images/thumb/Beta-Purple-SimmeringFury.png/150px-Beta-Purple-SimmeringFury.png?db0684" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-SimmeringFury.png/225px-Beta-Purple-SimmeringFury.png?db0684 1.5x, /images/thumb/Beta-Purple-SimmeringFury.png/300px-Beta-Purple-SimmeringFury.png?db0684 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Simmering_Fury" title="Simmering Fury">Simmering Fury</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Skill">Uncommon - Watcher - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">At the start of your next turn, enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span> and draw 2 cards.</div><div class="desc-upg" style="display:none">At the start of your next turn, enter <span class="keyword-trigger inline-trigger" data-name="Wrath" data-sequel="1" title=""><a href="/wiki/Keywords#Stance" title="Keywords">Wrath</a></span> and draw 3 cards.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Study" data-rarity="Uncommon" data-type="Power" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Study" title="Study"><img alt="Purple-Study.png" src="/images/thumb/Purple-Study.png/150px-Purple-Study.png?4c9ab2" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Study.png/225px-Purple-Study.png?4c9ab2 1.5x, /images/thumb/Purple-Study.png/300px-Purple-Study.png?4c9ab2 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Study" title="Study"><img alt="Purple-StudyPlus.png" src="/images/thumb/Purple-StudyPlus.png/150px-Purple-StudyPlus.png?76df1d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-StudyPlus.png/225px-Purple-StudyPlus.png?76df1d 1.5x, /images/thumb/Purple-StudyPlus.png/300px-Purple-StudyPlus.png?76df1d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Study" title="Study"><img alt="Beta-Purple-StudyPlus.png" src="/images/thumb/Beta-Purple-StudyPlus.png/150px-Beta-Purple-StudyPlus.png?ba991b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-StudyPlus.png/225px-Beta-Purple-StudyPlus.png?ba991b 1.5x, /images/thumb/Beta-Purple-StudyPlus.png/300px-Beta-Purple-StudyPlus.png?ba991b 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Study" title="Study"><img alt="Beta-Purple-Study.png" src="/images/thumb/Beta-Purple-Study.png/150px-Beta-Purple-Study.png?62010b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Study.png/225px-Beta-Purple-Study.png?62010b 1.5x, /images/thumb/Beta-Purple-Study.png/300px-Beta-Purple-Study.png?62010b 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Study" title="Study">Study</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Purple" data-type="Power">Uncommon - Watcher - Power</div><div class="card-desc compendium-cell-desc"><div class="desc-base">At the end of your turn, shuffle an <span class="card-trigger inline-trigger" data-name="Insight" data-sequel="1"><a href="/wiki/Insight" title="Insight"><img alt="CardIcon Colorless Skill Common.png" src="/images/thumb/CardIcon_Colorless_Skill_Common.png/24px-CardIcon_Colorless_Skill_Common.png?9ab8b5" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Skill_Common.png?9ab8b5 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Insight" title="Insight">Insight</a></span> into your draw pile.</div><div class="desc-upg" style="display:none">At the end of your turn, shuffle an <span class="card-trigger inline-trigger" data-name="Insight" data-sequel="1"><a href="/wiki/Insight" title="Insight"><img alt="CardIcon Colorless Skill Common.png" src="/images/thumb/CardIcon_Colorless_Skill_Common.png/24px-CardIcon_Colorless_Skill_Common.png?9ab8b5" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Colorless_Skill_Common.png?9ab8b5 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Insight" title="Insight">Insight</a></span> into your draw pile.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Swivel" data-rarity="Uncommon" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Swivel" title="Swivel"><img alt="Purple-Swivel.png" src="/images/thumb/Purple-Swivel.png/150px-Purple-Swivel.png?ee44a0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Swivel.png/225px-Purple-Swivel.png?ee44a0 1.5x, /images/thumb/Purple-Swivel.png/300px-Purple-Swivel.png?ee44a0 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a h