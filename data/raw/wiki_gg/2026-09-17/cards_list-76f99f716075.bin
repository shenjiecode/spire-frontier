ta-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/All_for_One" title="All for One">All for One</a></div><div class="card-meta" data-rarity="Rare" data-color="Blue" data-type="Attack">Rare - Defect - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 10 damage.<br />Put all cost 0 cards from your discard pile into your hand.</div><div class="desc-upg" style="display:none">Deal 14 damage.<br />Put all cost 0 cards from your discard pile into your hand.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Amplify" data-rarity="Rare" data-type="Skill" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Amplify" title="Amplify"><img alt="Blue-Amplify.png" src="/images/thumb/Blue-Amplify.png/150px-Blue-Amplify.png?c6d97a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Amplify.png/225px-Blue-Amplify.png?c6d97a 1.5x, /images/thumb/Blue-Amplify.png/300px-Blue-Amplify.png?c6d97a 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Amplify" title="Amplify"><img alt="Blue-AmplifyPlus.png" src="/images/thumb/Blue-AmplifyPlus.png/150px-Blue-AmplifyPlus.png?4a55a7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-AmplifyPlus.png/225px-Blue-AmplifyPlus.png?4a55a7 1.5x, /images/thumb/Blue-AmplifyPlus.png/300px-Blue-AmplifyPlus.png?4a55a7 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Amplify" title="Amplify"><img alt="Beta-Blue-AmplifyPlus.pn