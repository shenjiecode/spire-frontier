le=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Doppelganger" data-rarity="Rare" data-type="Skill" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="X" data-multiplayer="false" data-tags="Draw Energy Exhaust"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Doppelganger" title="Doppelganger"><img alt="Green-Doppelganger.png" src="/images/thumb/Green-Doppelganger.png/150px-Green-Doppelganger.png?a80ba0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-Doppelganger.png/225px-Green-Doppelganger.png?a80ba0 1.5x, /images/thumb/Green-Doppelganger.png/300px-Green-Doppelganger.png?a80ba0 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Doppelganger" title="Doppelganger"><img alt="Green-DoppelgangerPlus.png" src="/images/thumb/Green-DoppelgangerPlus.png/150px-Green-DoppelgangerPlus.png?25624a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-DoppelgangerPlus.png/225px-Green-DoppelgangerPlus.png?25624a 1.5x, /images/thumb/Green-DoppelgangerPlus.png/300px-Green-DoppelgangerPlus.png?25624a 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Doppelganger" title="Doppelganger"><img alt="Beta-Green-DoppelgangerPlus.png" src="/images/thumb/Beta-Green-DoppelgangerPlus.png/150px-Beta-Green-DoppelgangerPlus.png?5bdc7a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Green-DoppelgangerPlus.png/225px-Beta-Green-DoppelgangerPlus.png?5bdc7a 1.5x, /images/thumb/Beta-Green-DoppelgangerPlus.png/300px-Beta-Green-DoppelgangerPlus.