ver Soul">Sever Soul</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Red" data-type="Attack">Uncommon - Ironclad - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base"><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> all non-Attack cards in your hand.<br />Deal 16 damage.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> all non-Attack cards in your hand.<br />Deal 22 damage.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Shockwave" data-rarity="Uncommon" data-type="Skill" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Exhaust Vulnerable Weak"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Shockwave" title="Shockwave"><img alt="Red-Shockwave.png" src="/images/thumb/Red-Shockwave.png/150px-Red-Shockwave.png?669ac3" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Shockwave.png/225px-Red-Shockwave.png?669ac3 1.5x, /images/thumb/Red-Shockwave.png/300px-Red-Shockwave.png?669ac3 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Shockwave" title="Shockwave"><img alt="Red-ShockwavePlus.png" src="/images/thumb/Red-ShockwavePlus.png/150px-Red-ShockwavePlus.png?cd00c9" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-ShockwavePlus.png/225px-Red-ShockwavePlus.png?cd00c9 1.5x, /images/thumb/Red-ShockwavePlus.png/300px-Red-ShockwavePlus.png?cd00c9 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Shockwave" title="Shockwave"><img alt="Beta-Red-ShockwavePlus.png" src="/images/thumb/Beta-Red-ShockwavePlus.png/150px-Beta-Red-ShockwavePlus.png?87cd02" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-ShockwavePlus.png/225px-Beta-Red-ShockwavePlus.png?87cd02 1.5x, /images/thumb/Beta-Red-ShockwavePlus.png/300px-Beta-Red-ShockwavePlus.png?87cd02 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Shockwave" title="Shockwave"><img alt="Beta-Red-Shockwave.png" src="/images/thumb/Beta-Red-Shockwave.png/150px-Beta-Red-Shockwave.png?9d652d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Shockwave.png/225px-Beta-Red-Shockwave.png?9d652d 1.5x, /images/thumb/Beta-Red-Shockwave.png/300px-Beta-Red-Shockwave.png?9d652d 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Shockwave" title="Shockwave">Shockwave</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Red" data-type="Skill">Uncommon - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Apply 3 <span class="power-trigger inline-trigger" data-name="Weak" data-sequel="1"><a href="/wiki/Weak" title="Weak"><img alt="Icon Weak.png" src="/images/thumb/Icon_Weak.png/22px-Icon_Weak.png?261352" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Weak.png/33px-Icon_Weak.png?261352 1.5x, /images/thumb/Icon_Weak.png/44px-Icon_Weak.png?261352 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Weak" title="Weak">Weak</a></span> and <span class="power-trigger inline-trigger" data-name="Vulnerable" data-sequel="1"><a href="/wiki/Vulnerable" title="Vulnerable"><img alt="Icon Vulnerable.png" src="/images/thumb/Icon_Vulnerable.png/22px-Icon_Vulnerable.png?8c74cd" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Vulnerable.png/33px-Icon_Vulnerable.png?8c74cd 1.5x, /images/thumb/Icon_Vulnerable.png/44px-Icon_Vulnerable.png?8c74cd 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Vulnerable" title="Vulnerable">Vulnerable</a></span> to ALL enemies.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Apply 5 <span class="power-trigger inline-trigger" data-name="Weak" data-sequel="1"><a href="/wiki/Weak" title="Weak"><img alt="Icon Weak.png" src="/images/thumb/Icon_Weak.png/22px-Icon_Weak.png?261352" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Weak.png/33px-Icon_Weak.png?261352 1.5x, /images/thumb/Icon_Weak.png/44px-Icon_Weak.png?261352 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Weak" title="Weak">Weak</a></span> and <span class="power-trigger inline-trigger" data-name="Vulnerable" data-sequel="1"><a href="/wiki/Vulnerable" title="Vulnerable"><img alt="Icon Vulnerable.png" src="/images/thumb/Icon_Vulnerable.png/22px-Icon_Vulnerable.png?8c74cd" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Vulnerable.png/33px-Icon_Vulnerable.png?8c74cd 1.5x, /images/thumb/Icon_Vulnerable.png/44px-Icon_Vulnerable.png?8c74cd 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Vulnerable" title="Vulnerable">Vulnerable</a></span> to ALL enemies.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Spot Weakness" data-rarity="Uncommon" data-type="Skill" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Strength"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Spot_Weakness" title="Spot Weakness"><img alt="Red-SpotWeakness.png" src="/images/thumb/Red-SpotWeakness.png/150px-Red-SpotWeakness.png?4f323f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-SpotWeakness.png/225px-Red-SpotWeakness.png?4f323f 1.5x, /images/thumb/Red-SpotWeakness.png/300px-Red-SpotWeakness.png?4f323f 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Spot_Weakness" title="Spot Weakness"><img alt="Red-SpotWeaknessPlus.png" src="/images/thumb/Red-SpotWeaknessPlus.png/150px-Red-SpotWeaknessPlus.png?e3fe9f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-SpotWeaknessPlus.png/225px-Red-SpotWeaknessPlus.png?e3fe9f 1.5x, /images/thumb/Red-SpotWeaknessPlus.png/300px-Red-SpotWeaknessPlus.png?e3fe9f 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Spot_Weakness" title="Spot Weakness"><img alt="Beta-Red-SpotWeaknessPlus.png" src="/images/thumb/Beta-Red-SpotWeaknessPlus.png/150px-Beta-Red-SpotWeaknessPlus.png?469ef4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-SpotWeaknessPlus.png/225px-Beta-Red-SpotWeaknessPlus.png?469ef4 1.5x, /images/thumb/Beta-Red-SpotWeaknessPlus.png/300px-Beta-Red-SpotWeaknessPlus.png?469ef4 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Spot_Weakness" title="Spot Weakness"><img alt="Beta-Red-SpotWeakness.png" src="/images/thumb/Beta-Red-SpotWeakness.png/150px-Beta-Red-SpotWeakness.png?4d319c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-SpotWeakness.png/225px-Beta-Red-SpotWeakness.png?4d319c 1.5x, /images/thumb/Beta-Red-SpotWeakness.png/300px-Beta-Red-SpotWeakness.png?4d319c 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Spot_Weakness" title="Spot Weakness">Spot Weakness</a></div><div class="card-meta" data-rarity="Uncommon" data-color="Red" data-type="Skill">Uncommon - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">If the enemy intends to attack, gain 3 <span class="power-trigger inline-trigger" data-name="Strength" data-sequel="1"><a href="/wiki/Strength" title="Strength"><img alt="Icon Strength.png" src="/images/thumb/Icon_Strength.png/22px-Icon_Strength.png?be60bf" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Strength.png/33px-Icon_Strength.png?be60bf 1.5x, /images/thumb/Icon_Strength.png/44px-Icon_Strength.png?be60bf 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Strength" title="Strength">Strength</a></span>.</div><div class="desc-upg" style="display:none">If the enemy intends to attack, gain 4 <span class="power-trigger inline-trigger" data-name="Strength" data-sequel="1"><a href="/wiki/Strength" title="Strength"><img alt="Icon Strength.png" src="/images/thumb/Icon_Strength.png/22px-Icon_Strength.png?be60bf" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Strength.png/33px-Icon_Strength.png?be60bf 1.5x, /images/thumb/Icon_Strength.png/44px-Icon_Strength.png?be60bf 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Strength" title="Strength">Strength</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span cla