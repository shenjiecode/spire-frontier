ck" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Innate" data-sequel="1" title=""><a href="/wiki/Keywords#Innate" title="Keywords">Innate</a></span>.<br />Gain 13 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Bullseye" data-rarity="Uncommon" data-type="Attack" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Lock-On"><span class="card-image-wrap"><span class="img-ba