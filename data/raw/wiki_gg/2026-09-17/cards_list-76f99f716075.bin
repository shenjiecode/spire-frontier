your turn, lose 1 <span class="power-trigger inline-trigger" data-name="Dexterity" data-sequel="1"><a href="/wiki/Dexterity" title="Dexterity"><img alt="Icon Dexterity.png" src="/images/thumb/Icon_Dexterity.png/22px-Icon_Dexterity.png?83caf7" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Dexterity.png/33px-Icon_Dexterity.png?83caf7 1.5x, /images/thumb/Icon_Dexterity.png/44px-Icon_Dexterity.png?83caf7 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Dexterity" title="Dexterity">Dexterity</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Defend (Defect)" data-rarity="Basic" data-type="Skill" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Defend_(Defect)" title="Defend (Defect)"><img alt="Blue-Defend.png" src="/images/thumb/Blue-Defend.png/150px-Blue-Defend.png?5f95f0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Defend.png/225px-Blue-Defend.png?5f95f0 1.5x, /images/thumb/Blue-Defend.png/300px-Blue-Defend.png?5f95f0 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Defend_(Defect)" title="Defend (Defect)"><img alt="Blue-DefendPlus.png" src="/images/thumb/Blue-DefendPlus.png/150px-Blue-DefendPlus.png?69fa3a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-DefendPlus.png/225px-Blue-DefendPlus.png?69fa3a 1.5x, /images/thumb/Blue-DefendPlus.png/300px-Blue-DefendPlus.png?69fa3a 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Defend_(Defect)" title="Defe