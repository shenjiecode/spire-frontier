ume.png/150px-Red-Exhume.png?91a988" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Exhume.png/225px-Red-Exhume.png?91a988 1.5x, /images/thumb/Red-Exhume.png/300px-Red-Exhume.png?91a988 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Exhume" title="Exhume"><img alt="Red-ExhumePlus.png" src="/images/thumb/Red-ExhumePlus.png/150px-Red-ExhumePlus.png?d46fc4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-ExhumePlus.png/225px-Red-ExhumePlus.png?d46fc4 1.5x, /images/thumb/Red-ExhumePlus.png/300px-Red-ExhumePlus.png?d46fc4 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Exhume" title="Exhume"><img alt="Beta-Red-ExhumePlus.png" src="/images/thumb/Beta-Red-ExhumePlus.png/150px-Beta-Red-ExhumePlus.png?e52a50" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-ExhumePlus.png/225px-Beta-Red-ExhumePlus.png?e52a50 1.5x, /images/thumb/Beta-Red-ExhumePlus.png/300px-Beta-Red-ExhumePlus.png?e52a50 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Exhume" title="Exhume"><img alt="Beta-Red-Exhume.png" src="/images/thumb/Beta-Red-Exhume.png/150px-Beta-Red-Exhume.png?5cdaab" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Exhume.png/225px-Beta-Red-Exhume.png?5cdaab 1.5x, /images/thumb/Beta-Red-Exhume.png/300px-Beta-Red-Exhume.png?5cdaab 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Exhume" title="Exhume">Exhume</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Skill">Rare - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Put a card from your <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> pile into your hand.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Put a card from your <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> pile into your hand.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Feed" data-rarity="Rare" data-type="Attack" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Exhaust Fatal"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Feed" title="Feed"><img alt="Red-Feed.png" src="/images/thumb/Red-Feed.png/150px-Red-Feed.png?950c02" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Feed.png/225px-Red-Feed.png?950c02 1.5x, /images/thumb/Red-Feed.png/300px-Red-Feed.png?950c02 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Feed" title="Feed"><img alt="Red-FeedPlus.png" src="/images/thumb/Red-FeedPlus.png/150px-Red-FeedPlus.png?590b06" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-FeedPlus.png/225px-Red-FeedPlus.png?590b06 1.5x, /images/thumb/Red-FeedPlus.png/300px-Red-FeedPlus.png?590b06 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Feed" title="Feed"><img alt="Beta-Red-FeedPlus.png" src="/images/thumb/Beta-Red-FeedPlus.png/150px-Beta-Red-FeedPlus.png?2094fd" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-FeedPlus.png/225px-Beta-Red-FeedPlus.png?2094fd 1.5x, /images/thumb/Beta-Red-FeedPlus.png/300px-Beta-Red-FeedPlus.png?2094fd 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Feed" title="Feed"><img alt="Beta-Red-Feed.png" src="/images/thumb/Beta-Red-Feed.png/150px-Beta-Red-Feed.png?bf3601" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Feed.png/225px-Beta-Red-Feed.png?bf3601 1.5x, /images/thumb/Beta-Red-Feed.png/300px-Beta-Red-Feed.png?bf3601 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Feed" title="Feed">Feed</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Attack">Rare - Ironclad - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 10 damage.<br />If <span class="keyword-trigger inline-trigger" data-name="Fatal" data-sequel="1"><a href="/wiki/Fatal" title="Fatal"><span title="">Fatal</span></a></span>, raise your Max HP by 3. <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Deal 12 damage.<br />If <span class="keyword-trigger inline-trigger" data-name="Fatal" data-sequel="1"><a href="/wiki/Fatal" title="Fatal"><span title="">Fatal</span></a></span>, raise your Max HP by 4. <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Fiend Fire" data-rarity="Rare" data-type="Attack" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Exhaust Exhaust"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Fiend_Fire" title="Fiend Fire"><img alt="Red-FiendFire.png" src="/images/thumb/Red-FiendFire.png/150px-Red-FiendFire.png?716a64" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-FiendFire.png/225px-Red-FiendFire.png?716a64 1.5x, /images/thumb/Red-FiendFire.png/300px-Red-FiendFire.png?716a64 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Fiend_Fire" title="Fiend Fire"><img alt="Red-FiendFirePlus.png" src="/images/thumb/Red-FiendFirePlus.png/150px-Red-FiendFirePlus.png?da29c7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-FiendFirePlus.png/225px-Red-FiendFirePlus.png?da29c7 1.5x, /images/thumb/Red-FiendFirePlus.png/300px-Red-FiendFirePlus.png?da29c7 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Fiend_Fire" title="Fiend Fire"><img alt="Beta-Red-FiendFirePlus.png" src="/images/thumb/Beta-Red-FiendFirePlus.png/150px-Beta-Red-FiendFirePlus.png?7d2981" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-FiendFirePlus.png/225px-Beta-Red-FiendFirePlus.png?7d2981 1.5x, /images/thumb/Beta-Red-FiendFirePlus.png/300px-Beta-Red-FiendFirePlus.png?7d2981 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Fiend_Fire" title="Fiend Fire"><img alt="Beta-Red-FiendFire.png" src="/images/thumb/Beta-Red-FiendFire.png/150px-Beta-Red-FiendFire.png?e0b0a7" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-FiendFire.png/225px-Beta-Red-FiendFire.png?e0b0a7 1.5x, /images/thumb/Beta-Red-FiendFire.png/300px-Beta-Red-FiendFire.png?e0b0a7 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Fiend_Fire" title="Fiend Fire">Fiend Fire</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Attack">Rare - Ironclad - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base"><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> your hand.<br />Deal 7 damage for each card <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhausted</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none"><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span> your hand.<br />Deal 10 damage for each card <span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhausted</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Immolate" data-rarity="Rare" data-type="Attack" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags=""><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Immolate" title="Immolate"><img alt="Red-Immolate.png" src="/images/thumb/Red-Immolate.png/150px-Red-Immolate.png?851327" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Immolate.png/225px-Red-Immolate.png?851327 1.5x, /images/thumb/Red-Immolate.png/300px-Red-Immolate.png?851327 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Immolate" title="Immolate"><img alt="Red-ImmolatePlus.png" src="/images/thumb/Red-ImmolatePlus.png/150px-Red-ImmolatePlus.png?eabb5e" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-ImmolatePlus.png/225px-Red-ImmolatePlus.png?eabb5e 1.5x, /images/thumb/Red-ImmolatePlus.png/300px-Red-ImmolatePlus.png?eabb5e 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Immolate" title="Immolate"><img alt="Beta-Red-ImmolatePlus.png" src="/images/thumb/Beta-Red-ImmolatePlus.png/150px-Beta-Red-ImmolatePlus.png?ea482a" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-ImmolatePlus.png/225px-Beta-Red-ImmolatePlus.png?ea482a 1.5x, /images/thumb/Beta-Red-ImmolatePlus.png/300px-Beta-Red-ImmolatePlus.png?ea482a 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Immolate" title="Immolate"><img alt="Beta-Red-Immolate.png" src="/images/thumb/Beta-Red-Immolate.png/150px-Beta-Red-Immolate.png?f139e1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Immolate.png/225px-Beta-Red-Immolate.png?f139e1 1.5x, /images/thumb/Beta-Red-Immolate.png/300px-Beta-Red-Immolate.png?f139e1 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Immolate" title="Immolate">Immolate</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Attack">Rare - Ironclad - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 21 damage to ALL enemies.<br />Add a <span class="card-trigger inline-trigger" data-name="Burn" data-sequel="1"><a href="/wiki/Burn" title="Burn"><img alt="CardIcon Status.png" src="/images/thumb/CardIcon_Status.png/24px-CardIcon_Status.png?5935a6" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Status.png?5935a6 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Burn" title="Burn">Burn</a></span> into your discard pile.</div><div class="desc-upg" style="display:none">Deal 28 damage to ALL enemies.<br />Add a <span class="card-trigger inline-trigger" data-name="Burn" data-sequel="1"><a href="/wiki/Burn" title="Burn"><img alt="CardIcon Status.png" src="/images/thumb/CardIcon_Status.png/24px-CardIcon_Status.png?5935a6" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Status.png?5935a6 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Burn" title="Burn">Burn</a></span> into your discard pile.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Impervious" data-rarity="Rare" data-type="Skill" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Block Exhaust"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Impervious" title="Impervious"><img alt="Red-Impervious.png" src="/images/thumb/Red-Impervious.png/150px-Red-Impervious.png?bfe892" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Impervious.png/225px-Red-Impervious.png?bfe892 1.5x, /images/thumb/Red-Impervious.png/300px-Red-Impervious.png?bfe892 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Impervious" title="Impervious"><img alt="Red-ImperviousPlus.png" src="/images/thumb/Red-ImperviousPlus.png/150px-Red-ImperviousPlus.png?7dc748" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-ImperviousPlus.png/225px-Red-ImperviousPlus.png?7dc748 1.5x, /images/thumb/Red-ImperviousPlus.png/300px-Red-ImperviousPlus.png?7dc748 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Impervious" title="Impervious"><img alt="Beta-Red-ImperviousPlus.png" src="/images/thumb/Beta-Red-ImperviousPlus.png/150px-Beta-Red-ImperviousPlus.png?c77a36" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-ImperviousPlus.png/225px-Beta-Red-ImperviousPlus.png?c77a36 1.5x, /images/thumb/Beta-Red-ImperviousPlus.png/300px-Beta-Red-ImperviousPlus.png?c77a36 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Impervious" title="Impervious"><img alt="Beta-Red-Impervious.png" src="/images/thumb/Beta-Red-Impervious.png/150px-Beta-Red-Impervious.png?9fc7ce" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Impervious.png/225px-Beta-Red-Impervious.png?9fc7ce 1.5x, /images/thumb/Beta-Red-Impervious.png/300px-Beta-Red-Impervious.png?9fc7ce 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Impervious" title="Impervious">Impervious</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Skill">Rare - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Gain 30 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Gain 40 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Juggernaut" data-rarity="Rare" data-type="Power" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Juggernaut" title="Juggernaut"><img alt="Red-Juggernaut.png" src="/images/thumb/Red-Juggernaut.png/150px-Red-Juggernaut.png?27375b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Juggernaut.png/225px-Red-Juggernaut.png?27375b 1.5x, /images/thumb/Red-Juggernaut.png/300px-Red-Juggernaut.png?27375b 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Juggernaut" title="Juggernaut"><img alt="Red-JuggernautPlus.png" src="/images/thumb/Red-JuggernautPlus.png/150px-Red-JuggernautPlus.png?f87ed2" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-JuggernautPlus.png/225px-Red-JuggernautPlus.png?f87ed2 1.5x, /images/thumb/Red-JuggernautPlus.png/300px-Red-JuggernautPlus.png?f87ed2 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Juggernaut" title="Juggernaut"><img alt="Beta-Red-JuggernautPlus.png" src="/images/thumb/Beta-Red-JuggernautPlus.png/150px-Beta-Red-JuggernautPlus.png?64669d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-JuggernautPlus.png/225px-Beta-Red-JuggernautPlus.png?64669d 1.5x, /images/thumb/Beta-Red-JuggernautPlus.png/300px-Beta-Red-JuggernautPlus.png?64669d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Juggernaut" title="Juggernaut"><img alt="Beta-Red-Juggernaut.png" src="/images/thumb/Beta-Red-Juggernaut.png/150px-Beta-Red-Juggernaut.png?f68f5f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Juggernaut.png/225px-Beta-Red-Juggernaut.png?f68f5f 1.5x, /images/thumb/Beta-Red-Juggernaut.png/300px-Beta-Red-Juggernaut.png?f68f5f 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Juggernaut" title="Juggernaut">Juggernaut</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Power">Rare - Ironclad - Power</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Whenever you gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>, deal 5 damage to a random enemy.</div><div class="desc-upg" style="display:none">Whenever you gain <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>, deal 7 damage to a random enemy.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Limit Break" data-rarity="Rare" data-type="Skill" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Exhaust Strength Strength"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Limit_Break" title="Limit Break"><img alt="Red-LimitBreak.png" src="/images/thumb/Red-LimitBreak.png/150px-Red-LimitBreak.png?a0ae28" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-LimitBreak.png/225px-Red-LimitBreak.png?a0ae28 1.5x, /images/thumb/Red-LimitBreak.png/300px-Red-LimitBreak.png?a0ae28 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Limit_Break" title="Limit Break"><img alt="Red-LimitBreakPlus.png" src="/images/thumb/Red-LimitBreakPlus.png/150px-Red-LimitBreakPlus.png?eabad8" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-LimitBreakPlus.png/225px-Red-LimitBreakPlus.png?eabad8 1.5x, /images/thumb/Red-LimitBreakPlus.png/300px-Red-LimitBreakPlus.png?eabad8 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Limit_Break" title="Limit Break"><img alt="Beta-Red-LimitBreakPlus.png" src="/images/thumb/Beta-Red-LimitBreakPlus.png/150px-Beta-Red-LimitBreakPlus.png?36fed1" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-LimitBreakPlus.png/225px-Beta-Red-LimitBreakPlus.png?36fed1 1.5x, /images/thumb/Beta-Red-LimitBreakPlus.png/300px-Beta-Red-LimitBreakPlus.png?36fed1 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Limit_Break" title="Limit Break"><img alt="Beta-Red-LimitBreak.png" src="/images/thumb/Beta-Red-LimitBreak.png/150px-Beta-Red-LimitBreak.png?ecca28" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-LimitBreak.png/225px-Beta-Red-LimitBreak.png?ecca28 1.5x, /images/thumb/Beta-Red-LimitBreak.png/300px-Beta-Red-LimitBreak.png?ecca28 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Limit_Break" title="Limit Break">Limit Break</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Skill">Rare - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Double your <span class="power-trigger inline-trigger" data-name="Strength" data-sequel="1"><a href="/wiki/Strength" title="Strength"><img alt="Icon Strength.png" src="/images/thumb/Icon_Strength.png/22px-Icon_Strength.png?be60bf" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Strength.png/33px-Icon_Strength.png?be60bf 1.5x, /images/thumb/Icon_Strength.png/44px-Icon_Strength.png?be60bf 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Strength" title="Strength">Strength</a></span>.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Double your <span class="power-trigger inline-trigger" data-name="Strength" data-sequel="1"><a href="/wiki/Strength" title="Strength"><img alt="Icon Strength.png" src="/images/thumb/Icon_Strength.png/22px-Icon_Strength.png?be60bf" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Strength.png/33px-Icon_Strength.png?be60bf 1.5x, /images/thumb/Icon_Strength.png/44px-Icon_Strength.png?be60bf 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Strength" title="Strength">Strength</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Offering" data-rarity="Rare" data-type="Skill" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags="Draw Energy Exhaust Lose HP"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Offering" title="Offering"><img alt="Red-Offering.png" src="/images/thumb/Red-Offering.png/150px-Red-Offering.png?39a0a3" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Offering.png/225px-Red-Offering.png?39a0a3 1.5x, /images/thumb/Red-Offering.png/300px-Red-Offering.png?39a0a3 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Offering" title="Offering"><img alt="Red-OfferingPlus.png" src="/images/thumb/Red-OfferingPlus.png/150px-Red-OfferingPlus.png?b1af06" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-OfferingPlus.png/225px-Red-OfferingPlus.png?b1af06 1.5x, /images/thumb/Red-OfferingPlus.png/300px-Red-OfferingPlus.png?b1af06 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Offering" title="Offering"><img alt="Beta-Red-OfferingPlus.png" src="/images/thumb/Beta-Red-OfferingPlus.png/150px-Beta-Red-OfferingPlus.png?de1e64" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-OfferingPlus.png/225px-Beta-Red-OfferingPlus.png?de1e64 1.5x, /images/thumb/Beta-Red-OfferingPlus.png/300px-Beta-Red-OfferingPlus.png?de1e64 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Offering" title="Offering"><img alt="Beta-Red-Offering.png" src="/images/thumb/Beta-Red-Offering.png/150px-Beta-Red-Offering.png?d4b6d4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Offering.png/225px-Beta-Red-Offering.png?d4b6d4 1.5x, /images/thumb/Beta-Red-Offering.png/300px-Beta-Red-Offering.png?d4b6d4 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Offering" title="Offering">Offering</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Skill">Rare - Ironclad - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Lose 6 HP.<br />Gain <span class="keyword-trigger" data-name="@RE" data-sequel="1"><img alt="RedEnergy.png" src="/images/thumb/RedEnergy.png/20px-RedEnergy.png?d820a5" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/RedEnergy.png/30px-RedEnergy.png?d820a5 1.5x, /images/thumb/RedEnergy.png/40px-RedEnergy.png?d820a5 2x" data-file-width="164" data-file-height="164" /></span> <span class="keyword-trigger" data-name="@RE" data-sequel="1"><img alt="RedEnergy.png" src="/images/thumb/RedEnergy.png/20px-RedEnergy.png?d820a5" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/RedEnergy.png/30px-RedEnergy.png?d820a5 1.5x, /images/thumb/RedEnergy.png/40px-RedEnergy.png?d820a5 2x" data-file-width="164" data-file-height="164" /></span>.<br />Draw 3 cards.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Lose 6 HP.<br />Gain <span class="keyword-trigger" data-name="@RE" data-sequel="1"><img alt="RedEnergy.png" src="/images/thumb/RedEnergy.png/20px-RedEnergy.png?d820a5" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/RedEnergy.png/30px-RedEnergy.png?d820a5 1.5x, /images/thumb/RedEnergy.png/40px-RedEnergy.png?d820a5 2x" data-file-width="164" data-file-height="164" /></span> <span class="keyword-trigger" data-name="@RE" data-sequel="1"><img alt="RedEnergy.png" src="/images/thumb/RedEnergy.png/20px-RedEnergy.png?d820a5" decoding="async" loading="lazy" width="20" height="20" style="vertical-align: middle" srcset="/images/thumb/RedEnergy.png/30px-RedEnergy.png?d820a5 1.5x, /images/thumb/RedEnergy.png/40px-RedEnergy.png?d820a5 2x" data-file-width="164" data-file-height="164" /></span>.<br />Draw 5 cards.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Reaper" data-rarity="Rare" data-type="Attack" data-color="Red" data-canupgrade="true" data-hasbeta="true" data-cost="2" data-multiplayer="false" data-tags="Exhaust Heal"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Reaper" title="Reaper"><img alt="Red-Reaper.png" src="/images/thumb/Red-Reaper.png/150px-Red-Reaper.png?b8f53f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-Reaper.png/225px-Red-Reaper.png?b8f53f 1.5x, /images/thumb/Red-Reaper.png/300px-Red-Reaper.png?b8f53f 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Reaper" title="Reaper"><img alt="Red-ReaperPlus.png" src="/images/thumb/Red-ReaperPlus.png/150px-Red-ReaperPlus.png?68bf36" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Red-ReaperPlus.png/225px-Red-ReaperPlus.png?68bf36 1.5x, /images/thumb/Red-ReaperPlus.png/300px-Red-ReaperPlus.png?68bf36 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Reaper" title="Reaper"><img alt="Beta-Red-ReaperPlus.png" src="/images/thumb/Beta-Red-ReaperPlus.png/150px-Beta-Red-ReaperPlus.png?d6e459" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-ReaperPlus.png/225px-Beta-Red-ReaperPlus.png?d6e459 1.5x, /images/thumb/Beta-Red-ReaperPlus.png/300px-Beta-Red-ReaperPlus.png?d6e459 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Reaper" title="Reaper"><img alt="Beta-Red-Reaper.png" src="/images/thumb/Beta-Red-Reaper.png/150px-Beta-Red-Reaper.png?190e4f" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Red-Reaper.png/225px-Beta-Red-Reaper.png?190e4f 1.5x, /images/thumb/Beta-Red-Reaper.png/300px-Beta-Red-Reaper.png?190e4f 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Reaper" title="Reaper">Reaper</a></div><div class="card-meta" data-rarity="Rare" data-color="Red" data-type="Attack">Rare - Ironclad - Attack</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Deal 4 damage to ALL enemies. Heal HP equal to unblocked damage.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div><div class="desc-upg" style="display:none">Deal 5 damage to ALL enemies. Heal HP equal to unblocked damage.<br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1"><a href="/wiki/Exhaust" title="Exhaust"><span title="">Exhaust</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Defend (Silent)" data-rarity="Basic" data-type="Skill" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Block"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Defend_(Silent)" title="Defend (Silent)"><img alt="Green-Defend.png" src="/images/thumb/Green-Defend.png/150px-Green-Defend.png?60e189" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-Defend.png/225px-Green-Defend.png?60e189 1.5x, /images/thumb/Green-Defend.png/300px-Green-Defend.png?60e189 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Defend_(Silent)" title="Defend (Silent)"><img alt="Green-DefendPlus.png" src="/images/thumb/Green-DefendPlus.png/150px-Green-DefendPlus.png?a31db4" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-DefendPlus.png/225px-Green-DefendPlus.png?a31db4 1.5x, /images/thumb/Green-DefendPlus.png/300px-Green-DefendPlus.png?a31db4 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Defend_(Silent)" title="Defend (Silent)"><img alt="Beta-Green-DefendPlus.png" src="/images/thumb/Beta-Green-DefendPlus.png/150px-Beta-Green-DefendPlus.png?a99e79" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Green-DefendPlus.png/225px-Beta-Green-DefendPlus.png?a99e79 1.5x, /images/thumb/Beta-Green-DefendPlus.png/300px-Beta-Green-DefendPlus.png?a99e79 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Defend_(Silent)" title="Defend (Silent)"><img alt="Beta-Green-Defend.png" src="/images/thumb/Beta-Green-Defend.png/150px-Beta-Green-Defend.png?fe3f95" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Green-Defend.png/225px-Beta-Green-Defend.png?fe3f95 1.5x, /images/thumb/Beta-Green-Defend.png/300px-Beta-Green-Defend.png?fe3f95 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Defend_(Silent)" title="Defend (Silent)">Defend (Silent)</a></div><div class="card-meta" data-rarity="Basic" data-color="Green" data-type="Skill">Basic - Silent - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Gain 5 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.</div><div class="desc-upg" style="display:none">Gain 8 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Neutralize" data-rarity="Basic" data-type="Attack" data-color="Green" data-canupgrade="true" data-hasbeta="true" data-cost="0" data-multiplayer="false" data-tags="Weak"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Neutralize" title="Neutralize"><img alt="Green-Neutralize.png" src="/images/thumb/Green-Neutralize.png/150px-Green-Neutralize.png?f8b761" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Green-Neutralize.png/225px-Green-Neutralize.png?f8b761 1.5x, /images/thumb/Green-Neutralize.png/300px-Green-Neutralize.png?f8b761 2x" data-file-width="678" data-file-height="874" /></a></span><span class="im