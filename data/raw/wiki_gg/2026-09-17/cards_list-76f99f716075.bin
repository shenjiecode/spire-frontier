ain 2 <span class="keyword-trigger inline-trigger" data-name="Orb" data-sequel="1" title=""><a href="/wiki/Orbs" title="Orbs">Orb</a></span> slots.</div><div class="desc-upg" style="display:none">Gain 3 <span class="keyword-trigger inline-trigger" data-name="Orb" data-sequel="1" title=""><a href="/wiki/Orbs" title="Orbs">Orb</a></span> slots.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Chaos" data-rarity="Uncommon" data-type="Skill" data-color="Blue" data-canupgrade="true" data-hasbeta="true" data-cost="1" data-multiplayer="false" data-tags="Channel"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Chaos" title="Chaos"><img alt="Blue-Chaos.png" src="/images/thumb/Blue-Chaos.png/150px-Blue-Chaos.png?1d7445" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-Chaos.png/225px-Blue-Chaos.png?1d7445 1.5x, /images/thumb/Blue-Chaos.png/300px-Blue-Chaos.png?1d7445 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Chaos" title="Chaos"><img alt="Blue-ChaosPlus.png" src="/images/thumb/Blue-ChaosPlus.png/150px-Blue-ChaosPlus.png?5f0b67" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Blue-ChaosPlus.png/225px-Blue-ChaosPlus.png?5f0b67 1.5x, /images/thumb/Blue-ChaosPlus.png/300px-Blue-ChaosPlus.png?5f0b67 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Chaos" title="Chaos"><img alt="Beta-Blue-ChaosPlus.png" src="/images/thumb/Beta-Blue-ChaosPlus.png/150px-Beta-Blue-ChaosPlus.png?1f5de0" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Blue-ChaosPlus.png/225px-Beta-Blue-ChaosPlus.png?1f5de0 1.5x, /images/thumb/Beta-Bl