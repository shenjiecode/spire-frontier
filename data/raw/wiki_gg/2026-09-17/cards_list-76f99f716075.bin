SpiritShield.png?7b718b 1.5x, /images/thumb/Beta-Purple-SpiritShield.png/300px-Beta-Purple-SpiritShield.png?7b718b 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Spirit_Shield" title="Spirit Shield">Spirit Shield</a></div><div class="card-meta" data-rarity="Rare" data-color="Purple" data-type="Skill">Rare - Watcher - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Gain 3 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block">Block</a></span> for each card in your hand.</div><div class="desc-upg" style="display:none">Gain 4 <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block">Block</a></span> for each card in your hand.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Vault" data-rarity="Rare" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="3" data-multiplayer="false" data-tags="Exhaust"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Vault" title="Vault"><img alt="Purple-Vault.png" src="/images/thumb/Purple-Vault.png/150px-Purple-Vault.png?ffc31d" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Vault.png/225px-Purple-Vault.png?ffc31d 1.5x, /images/thumb/Purple-Vault.png/300px-Purple-Vault.png?ffc31d 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Vault" title="Vault"><img alt="Purple-VaultPlus.png" src="/images/thumb/Purple-VaultPlus.png/150px-Purple-VaultPlus.png?a29e18" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-VaultPlus.png/225px-Purple-VaultPlus.png?a29e18 1.5x, /images/thumb/Purple-VaultPlus.png/300px-Purple-VaultPlus.png?a29e18 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta-upg" style="display:none"><a href="/wiki/Vault" title="Vault"><img alt="Beta-Purple-VaultPlus.png" src="/images/thumb/Beta-Purple-VaultPlus.png/150px-Beta-Purple-VaultPlus.png?4dbd1c" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-VaultPlus.png/225px-Beta-Purple-VaultPlus.png?4dbd1c 1.5x, /images/thumb/Beta-Purple-VaultPlus.png/300px-Beta-Purple-VaultPlus.png?4dbd1c 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-beta" style="display:none"><a href="/wiki/Vault" title="Vault"><img alt="Beta-Purple-Vault.png" src="/images/thumb/Beta-Purple-Vault.png/150px-Beta-Purple-Vault.png?7a282b" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Beta-Purple-Vault.png/225px-Beta-Purple-Vault.png?7a282b 1.5x, /images/thumb/Beta-Purple-Vault.png/300px-Beta-Purple-Vault.png?7a282b 2x" data-file-width="678" data-file-height="874" /></a></span></span><div class="card-text"><div class="card-title compendium-cell-title"><a href="/wiki/Vault" title="Vault">Vault</a></div><div class="card-meta" data-rarity="Rare" data-color="Purple" data-type="Skill">Rare - Watcher - Skill</div><div class="card-desc compendium-cell-desc"><div class="desc-base">Take an extra turn after this one. <br />End your turn. <br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1" title=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div><div class="desc-upg" style="display:none">Take an extra turn after this one. <br />End your turn. <br /><span class="keyword-trigger inline-trigger" data-name="Exhaust" data-sequel="1" title=""><a href="/wiki/Keywords#Exhaust" title="Keywords">Exhaust</a></span>.</div></div><div class="card-toggles"><span class="card-toggle-button upgrade-toggle" role="button" tabindex="0">Upgraded</span><span class="card-toggle-button beta-toggle" role="button">Beta Art</span></div></div></div><div class="card-box" data-name="Wish" data-rarity="Rare" data-type="Skill" data-color="Purple" data-canupgrade="true" data-hasbeta="true" data-cost="3" data-multiplayer="false" data-tags="Exhaust Plated Armor Strength"><span class="card-image-wrap"><span class="img-base"><a href="/wiki/Wish" title="Wish"><img alt="Purple-Wish.png" src="/images/thumb/Purple-Wish.png/150px-Purple-Wish.png?9703cd" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-Wish.png/225px-Purple-Wish.png?9703cd 1.5x, /images/thumb/Purple-Wish.png/300px-Purple-Wish.png?9703cd 2x" data-file-width="678" data-file-height="874" /></a></span><span class="img-upg" style="display:none"><a href="/wiki/Wish" title="Wish"><img alt="Purple-WishPlus.png" src="/images/thumb/Purple-WishPlus.png/150px-Purple-WishPlus.png?cd70b5" decoding="async" loading="lazy" width="150" height="193" srcset="/images/thumb/Purple-WishPlus.png/225px-Purple-WishPlus.png?cd70b5 1.5x, /images/thumb/Purple-WishPlus.png/300px-Purple-WishPlus.png?cd70b5 2x" data-file-width="678" data-file-height="874" /></a></span><span 