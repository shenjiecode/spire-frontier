 href="/wiki/Catalyst" title="Catalyst"><img alt="CardIcon Silent Skill Uncommon.png" src="/images/thumb/CardIcon_Silent_Skill_Uncommon.png/24px-CardIcon_Silent_Skill_Uncommon.png?eaedc0" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Silent_Skill_Uncommon.png?eaedc0 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Catalyst" title="Catalyst">Catalyst</a></span></span>
<p><span class="relic-trigger inline-trigger" data-name="Snecko Skull" data-sequel="1"><a href="/wiki/Snecko_Skull" title="Snecko Skull"><img alt="SnakeSkull.png" src="/images/thumb/SnakeSkull.png/24px-SnakeSkull.png?40fc82" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/thumb/SnakeSkull.png/36px-SnakeSkull.png?40fc82 1.5x, /images/thumb/SnakeSkull.png/48px-SnakeSkull.png?40fc82 2x" data-file-width="156" data-file-height="156" /></a> <a href="/wiki/Snecko_Skull" title="Snecko Skull">Snecko Skull</a></span>, <span class="relic-trigger inline-trigger" data-name="The Specimen" data-sequel="1"><a href="/wiki/The_Specimen" title="The Specimen"><img alt="TheSpecimen.png" src="/images/thumb/TheSpecimen.png/24px-TheSpecimen.png?d3557f" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/thumb/TheSpecimen.png/36px-TheSpecimen.png?d3557f 1.5x, /images/thumb/TheSpecimen.png/48px-TheSpecimen.png?d3557f 2x" data-file-width="156" data-file-height="156" /></a> <a href="/wiki/The_Specimen" title="The Specimen">The Specimen</a></span>, <span class="relic-trigger inline-trigger" data-name="Twisted Funnel" data-sequel="1"><a href="/wiki/Twisted_Funnel" title="Twisted Funnel"><img alt="TwistedFunnel.png" src="/images/thumb/TwistedFunnel.png/24px-TwistedFunnel.png?db98b6" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/thumb/TwistedFunnel.png/36px-TwistedFunnel.png?db98b6 1.5x, /images/thumb/TwistedFunnel.png/48px-TwistedFunnel.png?db98b6 2x" data-file-width="156" data-file-height="156" /></a> <a href="/wiki/Twisted_Funnel" title="Twisted Funnel">Twisted Funnel</a></span>, <span class="inline-trigger potion-trigger" data-name="Poison Potion" data-sequel="1"><a href="/wiki/File:PoisonPotion.png" class="image"><img alt="PoisonPotion.png" src="/images/thumb/PoisonPotion.png/24px-PoisonPotion.png?dd014a" decoding="async" loading="lazy