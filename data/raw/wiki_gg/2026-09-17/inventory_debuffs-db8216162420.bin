<td>
</td>
<td>Intensity
</td>
<td>Integer limit
</td></tr>
<tr>
<td><div id="Mark"><a href="/wiki/File:Icon_Mark.png" class="image"><img alt="Icon Mark.png" src="/images/thumb/Icon_Mark.png/60px-Icon_Mark.png?18c1b0" decoding="async" loading="lazy" width="60" height="60" style="vertical-align: middle" srcset="/images/thumb/Icon_Mark.png/90px-Icon_Mark.png?18c1b0 1.5x, /images/thumb/Icon_Mark.png/120px-Icon_Mark.png?18c1b0 2x" data-file-width="128" data-file-height="128" /></a></div>
</td>
<td style="text-align:center; font-weight:bold;">
