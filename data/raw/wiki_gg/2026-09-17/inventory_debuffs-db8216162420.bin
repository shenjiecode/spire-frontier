Clear.png/33px-MonsterClear.png?a8c7db 1.5x, /images/thumb/MonsterClear.png/44px-MonsterClear.png?a8c7db 2x" data-file-width="96" data-file-height="96" /></a> <a href="/wiki/Slimes#Spike_Slime_(L)" title="Slimes">Spike Slime (L)</a></span>, <span class="enemy-trigger inline-trigger" data-name="Spike Slime (M)" data-sequel="1"><a href="/wiki/Slimes#Spike_Slime_(M)" title="Slimes"><img alt="MonsterClear.png" src="/images/thumb/MonsterClear.png/22px-MonsterClear.png?a8c7db" decoding="async" loading="lazy" width="22" height="22" style="vertical-align: middle" srcset="/images/thumb/MonsterClear.png/33px-MonsterClear.png?a8c7db 1.5x, /images/thumb/MonsterClear.png/44px-MonsterClear.png?a8c7db 2x" data-file-width="96" data-file-height="96" /></a> <a href="/wiki/Slimes#Spike_Slime_(M)" title="Slimes">Spike Slime (M)</a></span></span>
</td>
<td><span data-text="all"><span class="card-trigger inline-trigger" data-name="Shame" data-sequel="1"><a href="/wiki/Shame" title="Shame"><img alt="CardIcon Curse.png" src="/images/thumb/CardIcon_Curse.png/24px-CardIcon_Curse.png?f11a8c" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/CardIcon_Curse.png?f11a8c 1.5x" data-file-width="32" data-file-height="32" /></a> <a href="/wiki/Shame" title="Shame">Shame</a></span></span>
</td>
<td>Gain 25% less Block from cards for X turns.
</td>
<td>
<ul><li>Applied after <span class="power-trigger inline-trigger" data-name="Dexterity" data-sequel="1"><a href="/wiki/Dexterity" title="Dexterity"><img alt="Icon Dexterity.png" src="/images/thumb/Icon_Dexterity.png/22px-Icon_Dexterity.png?83caf7" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Dexterity.png/33px-Icon_Dexterity.png?83caf7 1.5x, /images/thumb/Icon_Dexterity.png/44px-Icon_Dexterity.png?83caf7 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Dexterity" title="Dexterity">Dexterity</a></span>, then final <span class="keyword-trigger inline-trigger" data-name="Block" data-sequel="1"><a href="/wiki/Block" title="Block"><img alt="Icon Block.png" src="/images/thumb/Icon_Block.png/18px-Icon_Block.png?de9e7c" decoding="async" loading="lazy" width="18" height="18" srcset="/images/thumb/Icon_Block.png/27px-Icon_Block.png?de9e7c 1.5x, /images/thumb/Icon_Block.png/36px-Icon_Block.png?de9e7c 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Block" title="Block"><span title="">Block</span></a></span> rounds down.</li>
<li>Specifically negated by <span class="relic-trigger inline-trigger" data-name="Turnip" data-sequel="1"><a href="/wiki/Turnip" title="Turnip"><img alt="Turnip.png" src="/images/thumb/Turnip.png/24px-Turnip.png?2143e1" decoding="async" loading="lazy" width="24" height="24" style="vertical-align: middle" srcset="/images/thumb/Turnip.png/36px-Turnip.png?2143e1 1.5x, /images/thumb/Turnip.png/48px-Turnip.png?2143e1 2x" data-file-width="156" data-file-height="156" /></a> <a href="/wiki/Turnip" title="Turnip">Turnip</a></span>.</li>
<li>Shares its affected cards with <span class="power-trigger inline-trigger" data-name="Dexterity" data-sequel="1"><a href="/wiki/Dexterity" title="Dexterity"><img alt="Icon Dexterity.png" src="/images/thumb/Icon_Dexterity.png/22px-Icon_Dexterity.png?83caf7" decoding="async" loading="lazy" width="22" height="22" srcset="/images/thumb/Icon_Dexterity.png/33px-Icon_Dexterity.png?83caf7 1.5x, /images/thumb/Icon_Dexterity.png/44px-Icon_Dexterity.png?83caf7 2x" data-file-width="109" data-file-height="109" /></a> <a href="/wiki/Dexterity" title="Dexterity">Dexterity</a></span>, rules can be view at <a href="/wiki/Dexterity#Interactions" title="Dexterity">Dexterity#Interactions</a></li></ul>
</td>
<td>Duration
</td>
<td>Integer limit
</td></tr>
<tr>
