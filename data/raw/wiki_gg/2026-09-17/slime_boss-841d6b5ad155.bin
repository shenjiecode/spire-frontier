<ul><li><span class="enemy-trigger inline-trigger" data-name="Byrd" data-sequel="1"><a href="/wiki/Byrd#Byrd" title="Byrd">Byrd</a></span></li>
<li><span class="enemy-trigger inline-trigger" data-name="Cultist" data-sequel="1"><a href="/wiki/Cultist#Cultist" title="Cultist">Cultist</a></span></li>
