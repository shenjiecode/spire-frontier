<li><span class="enemy-trigger inline-trigger" data-name="Snake Plant" data-sequel="1"><a href="/wiki/Snake_Plant#Snake_Plant" title="Snake Plant">Snake Plant</a></span></li>
<li><span class="enemy-trigger inline-trigger" data-name="Snecko" data-sequel="1"><a href="/wiki/Snecko#Snecko" title="Snecko">Snecko</a></span></li>
<li><span class="enemy-trigger inline-trigger" data-name="Spheric Guardian" data-sequel="1"><a href="/wiki/Spheric_Guardian#Spheric_Guardian" title="Spheric Guardian">Spheric Guardian</a></span></li>
