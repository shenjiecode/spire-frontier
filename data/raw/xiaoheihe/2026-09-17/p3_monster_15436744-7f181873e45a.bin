      <span>问题反馈</span>
    </div>
  </div>
  
</div>

<script>
isSharePage = false
</script>
<script src="https://cdn.max-c.com/js/hkey.js"></script>
<script src="//cdn.max-c.com/js/zepto/1.2.0/zepto.min.js"></script>
<script src="/static/wiki/js/common.js?v=1.1.11"></script>
<script>
  if (utils.getUrlParam('os_type') !== 'Android' && String(window.screen.height).match(/812|896/)) {
    document.body.classList.add('iphonex');
  }
</script>

<script src="/static/assets/js/img_lazyload_config.js?v=1.0.0"></script>
<script>
  var imgDescs = $('.img-desc');
  imgDescs.each(function () {
    var ethis = $(this);
    if (ethis.text() !== '请输入图片描述') {
      ethis.addClass('show-img-desc')
    }
  });

  $('.article-content table').each(function () {
    if ($(this).parents('.table-wrap').length < 1) {
      $(this).wrap('<div class="table-wrap"><div class="table-wrap-inner">');
    }
  });

  $('.article-content iframe').each(function () {
    var width = $(this).width();
    $(this).height(width * 9 / 16);
  });

  $('.editor-name').on('tap', function () {
    var PROTOCOL = {
      'protocol_type': 'openUser',
      'user_id': $(this).data('id')
    };
    window.location.href = 'heybox://' + encodeURI(JSON.stringify(PROTOCOL))
  });

  $('.tag-table .head').on('tap', function () {
    if ($(this).hasClass('unfold')) {
      $(this).removeClass('unfold').find('.switch .text').text('展开')
    } else {
      $(this).addClass('unfold').find('.switch .text').text('折叠')
    }
  });

  $('.reference-item .desc[data-link]').on('tap', function () {
    var url = $(this).data('link');
    W.appOpenWindow({
      title: title,
      url: url
    });
  });

  $('.feedback-panel .btn:not(.plain)').on('tap', function () {
    if ($(this).hasClass('done')) {
      return false
    }
    var type = $(this).data('type')
    var data = {
      article_id: '15436744'
    }
    if (type === 1) {
      data.useful = 1
    } else if (type === 2) {
      data.update_delay = 1
    } else if (type === 3) {
      data.content_inaccurate = 1
    }
    $.get('/wiki/collect_user_feedback/', data, function (res) {})
    $(this).addClass('done')
  })
</script>


<script src="https://cdn.max-c.com/js/iscroll/5.2.0/iscroll-lite.js"></script>
<script src="/static/wiki/js/catalogue.js?v=1.0.3"></script>
<script>
  W.entryLinkHandler('646570', '杀戮尖塔');
  var $imgs = $('.article-content img');
  $imgs.on('tap', function () {
    W.openImage({
      imgs: $imgs,
      index: $imgs.index($(this))
    });
  });

  $('.search-bar').on('tap', function () {
    W.appOpenWindow({
      title: '搜索',
      url: window.location.origin + '/wiki/search_wiki_page/?wiki_id=646570'
    });
  });
  $('.history-btn').on('tap', function () {
    W.appOpenWindow({
      title: '编辑历史',
      url: window.location.origin + '/wiki/get_article_edit_history/?wiki_id=646570&article_id=15436744'
    });
  });

  function refresh () {
    window.location.reload()
  }

  $('.tag-table .entry').on('tap', function () {
    var id = $(this).data('id');
    var title = $(this).text();
    W.appOpenWindow({
      title: title,
      url: window.location.origin + '/wiki/get_wiki_base_unit_detail_info/?wiki_id=646570&name=' + title
      // url: window.location.origin + '/wiki/get_article_list_by_category_id/?category_id=' + id
    });
  });

  $('#feedback').on('tap', function () {
    window.location.href = 'heybox://{"protocol_type":"openFeedback"}'
  })
</script>

<script src="https://cdn.max-c.com/static/data/js/lazysizes.4.0.1.min.js" async=""></script>

</body>
</html>
